#!/usr/bin/env bash
# ==============================================================================
# Script de Backup de etcd K8s - Generado automáticamente por Ansible
# ==============================================================================
set -euo pipefail

# Configuración
BACKUP_DIR="{{ etcd_local_backup_dir }}"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_FILE="${BACKUP_DIR}/etcd-snapshot-${TIMESTAMP}.db"
LOG_TAG="etcd-backup"

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] [$LOG_TAG] $*"
}

error() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] [$LOG_TAG] [ERROR] $*" >&2
}

log "Iniciando proceso de backup de etcd en $(hostname)..."

# Verificar existencia de etcdctl
if ! command -v etcdctl &> /dev/null; then
    error "La herramienta 'etcdctl' no está instalada o no está en el PATH."
    exit 1
fi

# Crear directorio si no existe
mkdir -p "${BACKUP_DIR}"
chmod 700 "${BACKUP_DIR}"

# Ejecutar el snapshot
log "Generando snapshot consistente de etcd..."
export ETCDCTL_API=3

if etcdctl \
  --endpoints="https://127.0.0.1:{{ etcd_client_port }}" \
  --cacert="{{ etcd_ca_cert }}" \
  --cert="{{ etcd_client_cert }}" \
  --key="{{ etcd_client_key }}" \
  snapshot save "${BACKUP_FILE}" > /dev/null; then
    
    # Comprimir el db generado para ahorrar ancho de banda y almacenamiento
    log "Snapshot creado en ${BACKUP_FILE}. Comprimiendo..."
    gzip -f "${BACKUP_FILE}"
    COMPRESSED_FILE="${BACKUP_FILE}.gz"
    
    chmod 600 "${COMPRESSED_FILE}"
    log "Backup completado exitosamente: ${COMPRESSED_FILE} ($(du -sh "${COMPRESSED_FILE}" | cut -f1))"
    
else
    error "Falló la generación del snapshot de etcd."
    exit 2
fi
